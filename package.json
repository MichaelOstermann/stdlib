{
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "globals": "bun scripts/globals.ts",
        "checks": "bun run style && dprint check && oxlint && tsc && tsc -p packages/stdlib && tsc -p packages/stdlib-web && tsc -p packages/stdlib-react && bun test",
        "bundles": "bun run --filter '*' bundle",
        "docs:dev": "blume dev",
        "docs:build": "blume build",
        "style": "bun run --filter @monstermann/stdlib-style bundle",
        "format": "dprint fmt && oxlint --fix"
    },
    "devDependencies": {
        "@monstermann/stdlib-style": "workspace:*",
        "@types/bun": "^1.4.2",
        "blume": "^2.2.3",
        "dprint": "^0.61.1",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.0"
    }
}

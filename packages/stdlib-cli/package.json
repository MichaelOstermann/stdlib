{
    "name": "@monstermann/stdlib-cli",
    "type": "module",
    "version": "0.1.0",
    "description": "Command line interfaces with flags only, next to @monstermann/stdlib.",
    "author": "Michael Ostermann <michaelostermann@me.com>",
    "license": "MIT",
    "homepage": "https://github.com/MichaelOstermann/stdlib",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MichaelOstermann/stdlib.git"
    },
    "bugs": {
        "url": "https://github.com/MichaelOstermann/stdlib/issues"
    },
    "keywords": [
        "cli",
        "command-line",
        "flags",
        "stdlib",
        "typescript"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./*": "./dist/*"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "bundle": "bun run tsdown"
    },
    "peerDependencies": {
        "@monstermann/stdlib": "workspace:^"
    },
    "devDependencies": {
        "@monstermann/stdlib": "workspace:*",
        "@monstermann/stdlib-transform": "workspace:*"
    }
}

{
    "indentWidth": 4,
    "markdown": {
        "associations": ["**/*.{md,mdx}"]
    },
    "malva": {},
    "markup": {},
    "excludes": [
        "**/node_modules",
        "**/dist",
        "**/target",
        "**/*.lock"
    ],
    "plugins": [
        "./dist/dprint-plugin.wasm",
        "https://plugins.dprint.dev/markdown-0.26.0.wasm",
        "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
        "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.5.wasm"
    ]
}

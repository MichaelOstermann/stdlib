exports[`react Should wrap call expressions with arguments in arrow function 1`] = `
"import { useSignal } from "@monstermann/stdlib-react";
export const useHook = () => {
    const foo = useSignal(() => (bar.$baz({ a: 1 })))
    return null
}"
`;

exports[`react Should transform complex expressions 1`] = `
"import { useSignal } from "@monstermann/stdlib-react";
export const useHook = () => {
    const a = useSignal(() => ($a() + $b()))
    const b = useSignal(() => ({ b: $b() }))
    const c = useSignal(() => ([$c()]))
    const d = useSignal(() => (util($d())))
    return null
}"
`;


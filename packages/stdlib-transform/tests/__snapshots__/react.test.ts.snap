import { Effect as E } from "@monstermann/stdlib/Effect.mjs";
import { Signal } from "some-other-package"
import { useSignal as useS } from "@monstermann/stdlib-react"
export function Component() {
    const $a = useS(0)
    const $b = Signal(0)
    useSignalEffect(() => {})
    return null
}"
`;


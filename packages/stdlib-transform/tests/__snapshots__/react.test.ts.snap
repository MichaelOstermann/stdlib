exports[`react Should transform complex expressions 1`] = `
"import { useReactive } from "@monstermann/stdlib-react";
export const useHook = () => {
    const a = useReactive(() => ($a() + $b()))
    const b = useReactive(() => ({ b: $b() }))
    const c = useReactive(() => ([$c()]))
    const d = useReactive(() => (util($d())))
    return null
}"
`;


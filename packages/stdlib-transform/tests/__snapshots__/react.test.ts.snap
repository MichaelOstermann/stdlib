}"
`;

exports[`react Should ignore writes in statements and callbacks 1`] = `
"export const Component = () => {
    $foo(100)
    const onClick = () => $foo(200)
    useEffect(() => {
        $foo(300)
    })
    return <div onClick={() => $foo(400)} onKeyDown={onClick} />
}"
`;


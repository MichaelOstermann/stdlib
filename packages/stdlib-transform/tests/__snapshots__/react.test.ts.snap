exports[`react Should wrap a hook argument, not the hook call, for a direct read 1`] = `
"import { useSignal } from "@monstermann/stdlib-react";
export function useHook() {
    const foo = useThing(useSignal($foo))
    return foo
}"
`;

exports[`react Should wrap a hook argument, not the hook call, for a nested read 1`] = `
"import { useSignal } from "@monstermann/stdlib-react";

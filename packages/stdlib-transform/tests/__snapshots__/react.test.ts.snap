export const a = memo(() => {
    const foo = useReactive($foo)
    return <div />
})
export const b = React.forwardRef((props, ref) => <div ref={ref}>{useReactive($foo)}</div>)"
`;

exports[`react Should transform components and hooks named by assignments and properties 1`] = `
"import { useReactive } from "@monstermann/stdlib-react";
Component = () => <div>{useReactive($foo)}</div>

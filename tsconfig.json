{
    "extends": "@monstermann/tsconfig",
    "compilerOptions": {
        "lib": ["DOM", "DOM.Iterable", "ES2023", "ES2025.Intl", "ESNext.Disposable"],
        "paths": {
            "@monstermann/stdlib": ["./packages/stdlib/src/index.ts"],
            "@monstermann/stdlib/*": ["./packages/stdlib/src/*"],
            "@monstermann/stdlib-web": ["./packages/stdlib-web/src/index.ts"]
        },
        "types": ["bun"]
    },
    "exclude": [
        "**/dist/**",
        "**/node_modules/**"
    ]
}
